{
  "name": "social-media-feed-parser",
  "version": "0.0.0",
  "private": true,
  "description": "Social Media Feed Parser monorepo",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --project packages/core/tsconfig.json --noEmit && tsc --project apps/desktop/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspace=@smp/core test && npm --workspace=@smp/desktop test",
    "web": "node apps/web/server.cjs",
    "start": "node apps/web/server.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0"
  }
}
